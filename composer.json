{
    "name": "augustdai/laravel-plugin",
    "version": "2.0.0",
    "description": "Laravel 10x 适配版插件系统",
    "license": "MIT",
    "authors": [
        {
            "name": "augustdai",
            "email": "augdai@163.com"
        }
